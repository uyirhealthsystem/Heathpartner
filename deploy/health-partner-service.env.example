# Copy to /opt/health-partner-service/shared/health-partner-service.env on the
# EC2 host and fill in. NEVER commit the real file.

NODE_ENV=production
PORT=3000

# Postgres (Neon / RDS). Use the pooled connection string for the app.
DATABASE_URL="postgresql://USER:CHANGE_ME@your-db-host/healthpartner?sslmode=require"

# SSL is on by default. Set to false only for a local Postgres without SSL.
# DB_SSL=false
