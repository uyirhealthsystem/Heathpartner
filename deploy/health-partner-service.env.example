# Copy to /opt/health-partner-service/shared/health-partner-service.env on the
# EC2 host and fill in. NEVER commit the real file.

NODE_ENV=production

# userservice calls this port for citizen referrals (/internal/v1 - see the
# README, "Citizen referrals"); its HP_SERVICE_URL must point here, e.g.
# http://<this host's private IP>:3000. Allow that in the security group for
# userservice only - keep the port closed to the internet: /internal/v1 has
# no token, and /api/v1 trusts the gateway's x-user-id / x-user-role.
PORT=3000

# Postgres (Neon / RDS). Use the pooled connection string for the app.
DATABASE_URL="postgresql://USER:CHANGE_ME@your-db-host/healthpartner?sslmode=require"

# SSL is on by default. Set to false only for a local Postgres without SSL.
# DB_SSL=false

# Neon: direct (non "-pooler") connection string for Prisma migrations.
# Optional - DATABASE_URL is used when unset.
# DIRECT_URL="postgresql://USER:CHANGE_ME@your-db-host/healthpartner?sslmode=require"
