// Used for migrations only - the app queries Postgres with `pg`.
// Change this file, then `npm run db:migrate:dev -- --name <change>`.
//
// The case-insensitive unique indexes on LOWER(name) for districts, blocks
// and villages can't be expressed here; they live in the migration SQL.

datasource db {
  provider = "postgresql"
}

model HealthPartner {
  id              String    @id @db.VarChar(100)
  userId          String    @unique @map("user_id") @db.VarChar(100)
  referralCode    String    @unique @map("referral_code") @db.VarChar(30)
  walletBalance   Decimal   @default(0) @map("wallet_balance") @db.Decimal(12, 2)
  status          String    @default("ACTIVE") @db.VarChar(30)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  fullName        String?   @map("full_name") @db.VarChar(150)
  phone           String?   @db.VarChar(20)
  email           String?   @db.VarChar(150)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          String?   @db.VarChar(20)
  addressLine1    String?   @map("address_line1") @db.VarChar(255)
  addressLine2    String?   @map("address_line2") @db.VarChar(255)
  city            String?   @db.VarChar(100)
  state           String?   @db.VarChar(100)
  pincode         String?   @db.VarChar(10)
  profilePhotoUrl String?   @map("profile_photo_url") @db.VarChar(500)
  districtId      String?   @map("district_id") @db.VarChar(100)
  blockId         String?   @map("block_id") @db.VarChar(100)
  villageId       String?   @map("village_id") @db.VarChar(100)

  district     District?     @relation(fields: [districtId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  block        Block?        @relation(fields: [blockId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  village      Village?      @relation(fields: [villageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referrals    Referral[]
  transactions Transaction[]
  bankAccount  BankAccount?
  withdrawals  Withdrawal[]

  @@index([districtId], map: "health_partners_district_idx")
  @@index([blockId], map: "health_partners_block_idx")
  @@index([villageId], map: "health_partners_village_idx")
  @@map("health_partners")
}

// Location master: District -> Block -> Village.
model District {
  id        String   @id @db.VarChar(100)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  blocks         Block[]
  healthPartners HealthPartner[]

  @@map("districts")
}

model Block {
  id         String   @id @db.VarChar(100)
  districtId String   @map("district_id") @db.VarChar(100)
  name       String   @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  district       District        @relation(fields: [districtId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  villages       Village[]
  healthPartners HealthPartner[]

  @@map("blocks")
}

model Village {
  id        String   @id @db.VarChar(100)
  blockId   String   @map("block_id") @db.VarChar(100)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  block          Block           @relation(fields: [blockId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  healthPartners HealthPartner[]

  @@map("villages")
}

// referred_type: CITIZEN | HEALTH_PARTNER, status: PENDING | COMPLETED |
// CANCELLED - enforced by CHECK constraints in the migration SQL. Citizen
// referrals are created PENDING by userservice (patient signed up with the
// code) and COMPLETED, with the reward, once the patient links their ABHA.
model Referral {
  id                      String   @id @db.VarChar(100)
  referrerHealthPartnerId String   @map("referrer_health_partner_id") @db.VarChar(100)
  referredUserId          String   @unique(map: "referrals_unique_user") @map("referred_user_id") @db.VarChar(100)
  referralCode            String   @map("referral_code") @db.VarChar(30)
  referredType            String   @map("referred_type") @db.VarChar(30)
  status                  String   @default("COMPLETED") @db.VarChar(30)
  rewardAmount            Decimal  @default(10) @map("reward_amount") @db.Decimal(12, 2)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  // null while PENDING
  completedAt             DateTime? @map("completed_at") @db.Timestamptz

  referrer HealthPartner @relation(fields: [referrerHealthPartnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("referrals")
}

model Transaction {
  id              String   @id @db.VarChar(100)
  healthPartnerId String   @map("health_partner_id") @db.VarChar(100)
  referralId      String?  @map("referral_id") @db.VarChar(100)
  type            String   @db.VarChar(40)
  amount          Decimal  @db.Decimal(12, 2)
  description     String   @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  healthPartner HealthPartner @relation(fields: [healthPartnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("transactions")
}

model BankAccount {
  id                String   @id @db.VarChar(100)
  healthPartnerId   String   @unique @map("health_partner_id") @db.VarChar(100)
  accountHolderName String   @map("account_holder_name") @db.VarChar(150)
  accountNumber     String   @map("account_number") @db.VarChar(50)
  ifscCode          String   @map("ifsc_code") @db.VarChar(20)
  bankName          String   @map("bank_name") @db.VarChar(150)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz

  healthPartner HealthPartner @relation(fields: [healthPartnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  withdrawals   Withdrawal[]

  @@map("bank_accounts")
}

model Withdrawal {
  id              String    @id @db.VarChar(100)
  healthPartnerId String    @map("health_partner_id") @db.VarChar(100)
  bankAccountId   String    @map("bank_account_id") @db.VarChar(100)
  amount          Decimal   @db.Decimal(12, 2)
  status          String    @default("PENDING") @db.VarChar(30)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  processedAt     DateTime? @map("processed_at") @db.Timestamptz

  healthPartner HealthPartner @relation(fields: [healthPartnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bankAccount   BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("withdrawals")
}
